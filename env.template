# =====================================================================
# 企业微信通知转发服务 (Go 重构版) - 环境变量模板
#
# 使用方法：cp env.template .env 并修改【必改】标记的值
# =====================================================================

# ---------- 服务器配置 ----------
PORT=12121

# ---------- 数据库配置 ----------
DB_PATH=./database/notifier.db

# ---------- 服务端口（docker-compose 层面）----------
HOST_BIND=0.0.0.0
HOST_PORT=12121

# ---------- 加密密钥【必改】----------
# 用于加密数据库中的 corp_id / corp_secret / EncodingAESKey / callback_token（AES-256-GCM）
# 解码后必须正好 32 字节，等价于下面任意一种：
#   - 64 位 hex        : openssl rand -hex 32
#   - 44 位 base64     : openssl rand -base64 32
#   - 32 个字符的字符串
ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# ---------- 应用配置 ----------
NODE_ENV=development

# ---------- 企业微信API基础URL（生产环境必须为 HTTPS，默认官方域名）----------
WECHAT_API_BASE=https://qyapi.weixin.qq.com

# ---------- 管理员登录配置【必改】----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ---------- 可信反向代理 ----------
TRUST_PROXY=false

# ---------- 隔离测试实例（生产环境留空）----------
TEST_INSTANCE_ID=

# ---------- 发送去重与企业微信请求限制（可选，默认值同 Node 原版）----------
# 相同通知在该时间窗内直接返回缓存结果（response.cached=true），请求体传 "force": true 可绕过
SEND_DEDUP_TTL_MS=30000
# 发往企业微信的请求体上限 / 响应体上限（字节，默认 5MB）
WECHAT_MAX_REQUEST_BYTES=5242880
WECHAT_MAX_RESPONSE_BYTES=5242880

# ---------- 跳过启动安全校验（仅本地开发；NODE_ENV=production 时不生效）----------
# SKIP_STARTUP_VALIDATION=1